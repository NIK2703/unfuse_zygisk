# ---------------------------------------------------------------------------
# Unfuse Zygisk — что НЕ попадает в репозиторий
# ---------------------------------------------------------------------------

# Артефакты сборки: zip-архивы модуля. Воспроизводятся одной командой ./build.sh.
# Готовые релизы лучше выкладывать в GitHub Releases, а не в историю git.
/out/

# Рабочие записи, а не исходники: разборы логов, дизайн-документы, дневники проекта.
# Живут локально и остаются доступными, но в публичном репозитории им не место.
# Ссылки на docs/*.md в комментариях исходников при этом остаются валидными локально.
/docs/
/.workbuddy-ai/memory/

# Снятые с устройства бинарники и диагностика: ZygiskNext, копии libc, сам
# /system/bin/vold (device/bin/vold — на нём проверяются патч и раскладка .plt
# без устройства, см. README §6.3). Это рабочий материал с конкретного аппарата,
# а не исходники проекта, и в git он не нужен.
/device/

# Мелочи окружения
*.log
*.tmp
.DS_Store

# Скомпилированные помощники стенда sdcardfs: собираются из лежащих рядом
# tools/sdcardfs/*.c
/tools/sdcardfs/runas
/tools/sdcardfs/nsprobe
