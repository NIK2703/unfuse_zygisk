# ---------------------------------------------------------------------------
# sdcardfs Restore — что НЕ попадает в репозиторий
# ---------------------------------------------------------------------------

# Артефакты сборки: zip-архивы модуля. Воспроизводятся одной командой ./build.sh.
# Готовые релизы лучше выкладывать в GitHub Releases, а не в историю git.
/out/

# Снятые с устройства чужие бинарники (ZygiskNext, LSPosed) и диагностика —
# см. README §15. Это рабочий материал для сверки ABI, а не исходники проекта:
# он тянется с конкретного аппарата локально и в git не нужен.
/device/

# Скомпилированные помощники: собираются из лежащих рядом tools/*.c
/tools/runas
/tools/nsprobe

# Мелочи окружения
*.log
*.tmp
.DS_Store
