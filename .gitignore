# ---------------------------------------------------------------------------
# sdcardfs Restore — что НЕ попадает в репозиторий
# ---------------------------------------------------------------------------

# Артефакты сборки: zip-архивы модуля. Воспроизводятся одной командой ./build.sh.
# Готовые релизы лучше выкладывать в GitHub Releases, а не в историю git.
/out/

# Снятые с устройства бинарники и диагностика: ZygiskNext, копии libc, сам
# /system/bin/vold (device/bin/vold — на нём проверяются патч и раскладка .plt
# без устройства, см. README §6.3). Это рабочий материал с конкретного аппарата,
# а не исходники проекта, и в git он не нужен.
/device/

# Скомпилированные помощники: собираются из лежащих рядом tools/*.c
/tools/runas
/tools/nsprobe

# Мелочи окружения
*.log
*.tmp
.DS_Store
