# /data/adb/modules/sdcardfs_restore/config
# ---------------------------------------------------------------------------
# sdcardfs Restore — глобальные переключатели.
#
# СПИСКА ПРИЛОЖЕНИЙ ЗДЕСЬ НЕТ И НЕ БУДЕТ: модуль восстанавливает внутреннюю
# память через sdcardfs для ВСЕХ приложений без исключений — ровно так, как это
# работало на Android 10 и более ранних версиях.
#
# Все строки, начинающиеся с '#', игнорируются. Значимые строки начинаются с '!'.
#
#   !enabled=0          выключить модуль целиком (то же, что !enabled=false)
#   !enabled=1          включить (по умолчанию)
#   !android_dirs=raw   (по умолчанию) Android/data и Android/obb отдаются
#                       напрямую через sdcardfs — виден свой каталог и каталоги
#                       других пакетов, как до scoped storage
#   !android_dirs=isolated
#                       вернуть штатное поведение Android 16: на Android/{data,obb}
#                       накладывается tmpfs и виден только свой пакет
#   !verbose=1          подробный лог (тег SdcardFsRestore в logcat)
#   !verbose=0          только важные сообщения (по умолчанию)
#
#   !relabel=1          (по умолчанию) перемаркировать КОРЕНЬ внутреннего
#                       хранилища /data/media: media_userdir_file ->
#                       media_rw_data_file. Это ОБЯЗАТЕЛЬНЫЙ шаг.
#
#                       sdcardfs не заводит собственный инод для корня точки
#                       монтирования: getattr() корня форвардится в нижний инод
#                       (/data/media), а у media_userdir_file для appdomain и
#                       coredomain разрешён ровно один search (domain.te:252).
#                       Поэтому без перемаркировки
#                           stat /storage/emulated  -> Permission denied
#                           ls   /storage/emulated  -> Permission denied
#                       причём БЕЗ единого AVC — доступ помечен dontaudit.
#                       Содержимое (/storage/emulated/0 и глубже) работает и
#                       без неё: там ярлык media_rw_data_file, на который у
#                       appdomain полные права (app.te:149).
#
#                       media_rw_data_file — ровно тот ярлык, что был у
#                       /data/media на Android 10 и раньше. Права (DAC) не
#                       меняются: /data/media остаётся 0551 uid 1023, а
#                       /data/media/0 — 2770 uid/gid 1023.
#   !relabel=0          не перемаркировать (корень хранилища будет отдавать
#                       EACCES на stat/ls; только для отладки)
#
#   !relax=1            (по умолчанию) снять лишние биты доступа с каталогов,
#                       через которые проходит sdcardfs:
#                         /mnt/runtime  0700 -> 0711
#                         /data/media   0550 -> 0551
#                       В обычной работе НЕ требуется — маунт из
#                       preAppSpecialize проходит и без этого. Нужно для
#                       диагностики из shell и как страховка.
#   !relax=runtime      только /mnt/runtime — хватает для bind-пути
#   !relax=media        только /data/media  — хватает для прямого маунта sdcardfs
#   !relax=0            не трогать права вообще (если маунт работает и так)
#
#   !selftest=1         самопроверка при КАЖДОМ запуске приложения: в лог
#                       пишутся личность процесса, права и stat/statfs по всем
#                       ключевым путям, пробы маунтов и разрешения SELinux.
#                       Пробы сразу откатываются, хранилище не портится.
#                       Нужно для разбора, в обычной работе не включать.
#   !selftest=0         (по умолчанию) диагностика только при отказе
#
# ---------------------------------------------------------------------------
# Что именно делает модуль
#
#   Каждый обычный процесс, который запускает Zygote, получает приватный
#   mount namespace, в котором /mnt/user/<user>/emulated — это sdcardfs, а не
#   FUSE. Дальше Zygote сам рекурсивно биндит /mnt/user/<user> на /storage,
#   поэтому sdcardfs оказывается и на /storage/emulated.
#
#   Маунт берётся с опциями mask=0007 и gid=9997 (AID_EVERYBODY). Драйвер
#   считает права как 0775 & ~mask, то есть каталоги 0770 и файлы 0660, а
#   AID_EVERYBODY есть у любого процесса. Итог — полный доступ ко ВСЕЙ
#   внутренней памяти, включая Android/data, Android/obb и каталоги чужих
#   пакетов. Это и есть поведение Android 10 и раньше.
#
#   Кого модуль НЕ трогает (это не приложения):
#     MediaProvider, installd, DownloadManager, ExternalStorageProvider —
#     им нужен сырой /data/media, иначе отвалится сам слой хранилища;
#     изолированные процессы — у них внешнего хранилища нет вовсе.
#
# ---------------------------------------------------------------------------
# Изменения подхватываются без перезагрузки: конфиг читается один раз за запуск
# процесса, поэтому достаточно выгрузить приложение из недавних.
#
# Ярлык /data/media (директива !relabel=) и права на /mnt/runtime и /data/media
# (директива !relax=) применяются скриптами модуля при загрузке — их смена
# требует перезагрузки. Ярлык ставится дважды: в post-fs-data (до старта Zygote,
# чтобы все приложения видели уже верный) и в service (после vold, который мог
# вернуть исходный). Патчить sepolicy не требуется: право на media_rw_data_file
# у appdomain уже есть (app.te:149).
# ---------------------------------------------------------------------------

# !enabled=1
# !android_dirs=raw
# !verbose=0
# !relabel=1
# !relax=1
# !selftest=0
